# Scripts que rodam em Linux/macOS precisam de quebra de linha LF.
# Com CRLF o bash falha com "\r: command not found".
*.sh   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Scripts que rodam no Windows
*.bat  text eol=crlf
*.vbs  text eol=crlf

# Binários, sem conversão
*.png  binary
*.ico  binary
*.icns binary
